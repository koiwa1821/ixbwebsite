{
  "name": "ixb-website",
  "version": "1.0.0",
  "private": true,
  "description": "IXB サイトの Sass ビルド設定（Bootstrap 5 カスタマイズ）",
  "scripts": {
    "build:css": "sass scss/custom.scss:docs/css/bootstrap.custom.css --style=compressed --no-source-map",
    "watch:css": "sass --watch scss/custom.scss:docs/css/bootstrap.custom.css --no-source-map"
  },
  "devDependencies": {
    "bootstrap": "^5.3.3",
    "sass": "^1.77.8"
  }
}
